#!/usr/bin/env bash
# codex-run — hand a mechanical chain to Codex in its own harness and get back only a RETURN block.
# Shaan, 2 Oct ~14:35: Opus for reasoning; worker chains go to Codex Luna (gpt-6-luna), Sol (gpt-6.1-sol) for heavier
# coding, on the Codex credits. An Opus owner pays for every step at its full context; codex-run moves the chain's
# steps out of that context and returns ≤200 words. Codex never runs as a Claude subagent: call this from Bash
# (run_in_background for anything over a minute; the completion notice is your wake).
#
#   codex-run [--as WORKER] [--sol --why "<reason>"] [-e low|medium|high] [-C DIR] [--mcp] [--task ID] [--alloc credits:N] [--chain C] BRIEF_FILE
#   Always passes -m (gpt-6.1-sol by default since 4 Oct; -m gpt-6-luna for Luna): never the global Codex default, which is Shaan's own app setting (A0, 2 Oct).
#   --sol needs --why (or SISO_SOL_WHY); the reason goes to bin/codex-sol-why's log and the run's log row.
#             (or - for stdin, or "a one-line brief")
#   Agent Base shows each worker by --as NAME, its job by $SISO_BATCH (the group title) and $SISO_ABOUT (one line on what this
#   worker does: "reads the composer source for width bugs"). Set all three so the faces pill and popup read well (UI, 4 Oct).
# --task (default $SISO_TASK) stamps the run for the token ledger (so-020): the brief starts "TASK: ID", the thread gets
# a siso-task mark, and the log row carries task, alloc and thread, so bin/spend-ledger charges it to that task.
#
# Stdout: the worker's final message (the RETURN block), then "LOG <path>". Exit 0 done, 1 failed/blocked, 2 usage.
# Runs are not --ephemeral, so bin/codex-credits meters them. Every run appends {model, secs, tokens, status} to ~/.local/state/codex-run/log.jsonl, so cost per task is measured.
# MCP servers are off by default (a worker chain doesn't need them, and the unauthenticated ones slow the boot);
# --mcp keeps them.
set -euo pipefail
# Sol 6.1 is the default since 4 Oct (Shaan: "stop using Luna, just use Sol 6.1"); -m gpt-6-luna still picks Luna.
workspace=${A0_WORKSPACE:-} parent=${AB_HOST_NAME:-Agent Zero}
as=${CODEX_RUN_AS:-} model=gpt-6.1-sol effort=medium dir=$PWD mcp=0 task=${SISO_TASK:-} alloc=${SISO_ALLOC:-} chain=${SISO_CHAIN:-} why=${SISO_SOL_WHY:-"default worker (Shaan 4 Oct: just use Sol 6.1)"}
while (($#)); do
  case $1 in
    --sol) model=gpt-6.1-sol; shift ;;
    --why) why=$2; shift 2 ;;
    -m) model=$2; shift 2 ;;
    -e) effort=$2; shift 2 ;;
    -C) dir=$2; shift 2 ;;
    --workspace) workspace=$2; shift 2 ;;
    --parent) parent=$2; shift 2 ;;
    --as) as=$2; shift 2 ;;   # a standing worker's name ("Builder"): Agent Base gives it one left-nav row across runs
    --mcp) mcp=1; shift ;;
    --task) task=$2; shift 2 ;;
    --alloc) alloc=$2; shift 2 ;;
    --chain) chain=$2; shift 2 ;;
    -h|--help) sed -n 2,16p "$0"; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
(($# == 1)) || { echo "usage: codex-run [--sol --why \"reason\"] [-e effort] [-C DIR] [--mcp] [--task ID] [--alloc credits:N] BRIEF_FILE|-|\"brief\"" >&2; exit 2; }
if [[ $model == gpt-6.1-sol ]]; then
  "$(dirname "$(readlink -f "$0")")/codex-sol-why" --by codex-run --name "codex-run${task:+ $task}" --task "$task" --why "$why" || exit 2
fi
if [[ $1 == - ]]; then brief=$(cat); elif [[ -f $1 ]]; then brief=$(cat "$1"); else brief=$1; fi
[[ -n $task ]] && brief="TASK: $task

$brief"

state=${CODEX_RUN_STATE:-$HOME/.local/state/codex-run}
mkdir -p "$state/runs"
run="$state/runs/$(date +%Y%m%dT%H%M%S)-$$"
contract='

---
You own this piece of work for Shaan (5 Oct: "all agents should feel value in improving the project and not just following the
spec ... be bold and brave and have ownership and care about the outcome"). The brief above is the goal and the facts, not a fence:
reach the outcome it describes. If a step it prescribes is wrong or blocked, find another way to the outcome and say why, rather than
stopping; if you see a clearly better approach or something it missed, take it and say so. The hard lines stay hard: work in this
directory, never commit, push, reset, stash or delete unless the brief says to, never deploy to production, never touch the work of others.
Keep command output small (tail, head, grep -m). Prove each claim with what you observed (exit codes, HTTP statuses, test counts,
file listings). Stop and report only when the outcome truly needs a decision or access you do not have. Your final message is ONLY this block, at most 200 words:

RETURN
STATUS: done | failed | blocked — <one line>
CHANGED: <files or remote state you changed, or "nothing">
VERIFY: <checks run and their results>
EVIDENCE: <paths, with the 1-3 decisive lines quoted>'
args=(exec -m "$model" -c "model_reasoning_effort=$effort" -C "$dir" --skip-git-repo-check --json
  -o "$run.last.md")
if ((!mcp)); then
  # Config tables merge: an empty table leaves global AND plugin MCPs enabled.
  # Ask this installed Codex for its effective catalog (no server connections),
  # then disable each entry explicitly. Inert transport placeholders keep
  # plugin-only entries valid without forwarding URL/command credentials to
  # argv; disabled servers are never started. --mcp retains every original tool.
  mcp_override=$(python3 - "${CODEX_BIN:-codex}" "$dir" <<'PY'
import json, subprocess, sys
try:
    p = subprocess.run([sys.argv[1], "-C", sys.argv[2], "mcp", "list", "--json"],
                       capture_output=True, text=True, check=True, timeout=20)
    servers = json.loads(p.stdout)
    if not isinstance(servers, list): raise ValueError("invalid catalog")
    entries = []
    for server in servers:
        if not server.get("enabled"): continue
        name, transport = server["name"], server["transport"]
        if not isinstance(name, str): raise ValueError("invalid name")
        key = "command" if transport["type"] == "stdio" else "url" if transport["type"] == "streamable_http" else None
        if key is None: raise ValueError("unknown transport")
        placeholder = "false" if key == "command" else "http://127.0.0.1"
        entries.append(json.dumps(name) + "={" + key + "=" + json.dumps(placeholder) + ",enabled=false}")
    print("mcp_servers={" + ",".join(entries) + "}")
except Exception:
    print("codex-run: MCP catalog unavailable; cannot guarantee MCP-free boot. Use --mcp for the full tool set.", file=sys.stderr)
    sys.exit(2)
PY
  ) || exit 2
  args+=(-c "$mcp_override")
fi
start=$(date +%s)
# Who started this run, so Agent Base can draw it as a sub-agent of that chat, live, with tokens per second (Shaan, 4 Oct: "how
# can we make that also work with codex so we get that cool animation and we can see tokens per second"). $run.jsonl streams live.
python3 -c 'import json,os,sys; b=sys.argv[3]; t=next((l[5:].strip() for l in b.splitlines()[:3] if l.startswith("TASK:")), "")
json.dump({"parent_session": os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("A0_SESSION_ID"), "parent_pane": os.environ.get("HERDR_PANE_ID"), "workspace": sys.argv[9] or None, "parent": sys.argv[10],
  "name": (t.split("(")[0].strip() or b.strip().splitlines()[0][:60]), "model": sys.argv[1], "effort": sys.argv[2], "dir": sys.argv[4],
  "pid": int(sys.argv[5]), "started": int(sys.argv[6]), "worker": sys.argv[8] or None, "batch": os.environ.get("SISO_BATCH") or None, "about": os.environ.get("SISO_ABOUT") or None, "tickets": (lambda re, h: sorted(set(re.findall(r"\bt-\d{4}\b", h)) | {f"t-{n:04d}" for a, z in re.findall(r"t-(\d{4}) to t-(\d{4})", h) for n in range(int(a), int(z) + 1)}))(__import__("re"), b.splitlines()[0] if b else "")}, open(sys.argv[7], "w"))
import datetime, fcntl, socket
from pathlib import Path
p = Path(os.environ.get("A0_DISPATCH_FILE", str(Path.home() / ".local/state/a0/dispatch.jsonl")))
p.parent.mkdir(parents=True, exist_ok=True)
with p.open("a") as f:
 fcntl.flock(f, fcntl.LOCK_EX)
 f.write(json.dumps({"at": datetime.datetime.now().isoformat(), "kind": "codex-run", "name": sys.argv[8] or t.split("(")[0].strip() or b.strip().splitlines()[0][:60], "workspace": sys.argv[9] or None, "parent": sys.argv[10], "machine": "mini" if "mini" in socket.gethostname().lower() else "laptop", "brief": b.strip().splitlines()[0][:120], "out": sys.argv[7].replace(".meta.json", ".last.md")}) + "\n")
 f.flush(); os.fsync(f.fileno())' "$model" "$effort" "$brief" "$dir" "$$" "$(date +%s)" "$run.meta.json" "$as" "$workspace" "$parent"
set +e
SISO_TASK=$task SISO_ALLOC=$alloc SISO_CHAIN=$chain "${CODEX_BIN:-codex}" "${args[@]}" "$brief$contract" > "$run.jsonl" 2> "$run.err" < /dev/null
rc=$?
set -e
secs=$(($(date +%s) - start))
python3 - "$run" "$model" "$effort" "$dir" "$secs" "$rc" "$state/log.jsonl" "$task" "$alloc" "$(dirname "$(readlink -f "$0")")" "$chain" "$why" <<'PY'
import datetime as dt, json, re, sys, time, importlib.machinery, importlib.util, os
run, model, effort, d, secs, rc, log, task, alloc, bindir, chain, why = sys.argv[1:13]
use, thread = {}, None
for line in open(run + ".jsonl", errors="replace"):
    try: e = json.loads(line)
    except ValueError: continue
    if e.get("type") == "thread.started": thread = e.get("thread_id")
    if e.get("type") == "turn.completed":
        for k, v in (e.get("usage") or {}).items(): use[k] = use.get(k, 0) + v
try: last = open(run + ".last.md").read()
except OSError: last = ""
m = re.search(r"STATUS:\s*(\w+)", last)
status = m[1].lower() if m else ("no-return" if rc == "0" else "error")
al = ch = None
if task:
    l = importlib.machinery.SourceFileLoader("siso_task", os.path.join(bindir, "siso-task"))
    st = importlib.util.module_from_spec(importlib.util.spec_from_loader("siso_task", l)); l.exec_module(st)
    try: al = st.parse_alloc(alloc)
    except ValueError: al = None
    try: ch = st.parse_chain(chain)
    except ValueError: ch = None
    if thread:  # the run's start, so every step of the thread falls after it
        st.mark(thread, task, al, "codex-run", chain=ch, at=dt.datetime.fromtimestamp(time.time() - int(secs)).astimezone().isoformat(timespec="seconds"))
row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "model": model, "effort": effort, "dir": d, "secs": int(secs),
       "exit": int(rc), "status": status, **use, "run": run, "task": task or None, "alloc": al, "chain": ch, "thread": thread,
       **({"sol_why": why} if model == "gpt-6.1-sol" else {})}
open(log, "a").write(json.dumps(row) + "\n")
PY
if [[ -s $run.last.md ]]; then cat "$run.last.md"; echo; else echo "RETURN"; echo "STATUS: blocked — codex exited $rc with no final message"; tail -5 "$run.err"; fi
echo "LOG $run.jsonl"
[[ -f $run.last.md ]] && grep -qE "STATUS:[[:space:]]*done" "$run.last.md"
