#!/usr/bin/env python3
"""Install the checked seat rotator and its 15-minute user launchd job."""
import hashlib
import json
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import tempfile

repo = Path(__file__).resolve().parents[1]
source = repo / 'bin/seat-fresh-t3'
revision = subprocess.check_output(['git', '-C', str(repo), 'rev-parse', 'HEAD'], text=True).strip()
checked = subprocess.check_output(['git', '-C', str(repo), 'show', revision + ':bin/seat-fresh-t3'])
if checked != source.read_bytes():
    raise SystemExit('Commit the checked command before installation.')
bundle = Path.home() / '.local/lib/siso-harness-lab' / revision[:12]
(bundle / 'bin').mkdir(parents=True, exist_ok=True)
target = bundle / 'bin/seat-fresh-t3'
if target.exists() and target.read_bytes() != source.read_bytes():
    raise SystemExit('Installed revision differs; commit the checked source before installing.')
shutil.copy2(source, target)
manifest = {'revision': revision, 'files': {'bin/seat-fresh-t3': hashlib.sha256(target.read_bytes()).hexdigest()}}
(bundle / 'SEAT-FRESH-INSTALL.json').write_text(json.dumps(manifest, indent=2) + '\n')
launcher = Path.home() / '.local/bin/seat-fresh-t3'
launcher.parent.mkdir(parents=True, exist_ok=True)
# Atomic launcher switch, preserving the previous version for rollback.
with tempfile.NamedTemporaryFile(mode='w', dir=launcher.parent, prefix='.seat-fresh-', delete=False) as out:
    out.write('#!/bin/sh\nexec "' + str(target) + '" "$@"\n')
    os.fchmod(out.fileno(), 0o755)
    temp = out.name
os.replace(temp, launcher)
state = Path.home() / '.local/state/agent-base'
state.mkdir(parents=True, exist_ok=True)
log = state / 'seat-fresh.log'
log.touch(mode=0o600, exist_ok=True)
os.chmod(log, 0o600)
label = 'com.siso.seat-fresh-t3'
plist = Path.home() / 'Library/LaunchAgents' / (label + '.plist')
plist.parent.mkdir(parents=True, exist_ok=True)
job = {'Label': label, 'ProgramArguments': [str(launcher), '--all-long'], 'StartInterval': 900,
       'RunAtLoad': True, 'StandardOutPath': str(log), 'StandardErrorPath': str(log),
       'EnvironmentVariables': {'PATH': str(Path.home() / '.local/bin') + ':/opt/homebrew/bin:/usr/bin:/bin',
                                'PYTHONUNBUFFERED': '1'}, 'ProcessType': 'Background', 'LowPriorityIO': True}
plist.write_bytes(plistlib.dumps(job))
domain = 'gui/' + str(os.getuid())
subprocess.run(['launchctl', 'bootout', domain + '/' + label], capture_output=True)
subprocess.run(['launchctl', 'bootstrap', domain, str(plist)], check=True)
print(json.dumps({'installed': str(target), 'sha256': manifest['files']['bin/seat-fresh-t3'],
                  'job': label, 'intervalSeconds': 900, 'log': str(log)}))
