#!/usr/bin/env python3
"""spend-report [--day YYYY-MM-DD] [--json] — where the Claude and Codex spend went: project -> owner -> agent -> plan item.

Shaan, 2 Oct (via A0): "track what that usage was spent on and make sure it doesn't just get swept under the rock ...
see like where the value's gotten". One day, both meters, attributed:
  - Claude: every assistant step in every transcript (both logins, subagents folded into their parent), weighted at
    API list prices per model (an equivalent, not a bill; scripts/plan-report.py's weights), charged to the session's
    agent name (herdr -n), else its cwd.
  - Codex: every response in ~/.codex/sessions rollouts, priced in credits (bin/codex-credits), charged to the herdr
    agent that runs that thread (names remembered in STATE/codex-names.json), else codex-run's caller dir, else cwd.
  - agent -> project/owner from the Agent Base registry (~/.local/state/agent-base/registry.json); unknown agents by
    path (partners/halo -> HALO, siso-internal-labs -> SISO Internal Labs, ...).
  - plan items: each step is charged to the plan ids (owners' .agents/plan/*.json, A0 T-#### tasks) named in that
    agent's NEXT report line (A0 inbox, Agent Base inbox) the same day: work comes before its report. Steps with no
    later id-bearing report stay "unattributed" and are shown, never dropped.
  - finished: report lines with an upper-case DONE or opening "done"; ids named there are finished items.
Prints "spent X on <project> -> finished Y" per project; --json for Agent Base dashboards.
"""
import collections, datetime as dt, glob, importlib.machinery, importlib.util, json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
WS = os.path.expanduser("~/SISO_Workspace")
REGISTRY = os.environ.get("SPEND_REGISTRY") or os.path.expanduser("~/.local/state/agent-base/registry.json")
INBOXES = (os.environ.get("SPEND_INBOXES") or ":".join([
    f"{WS}/SISO_Agents/agent-zero/siso-agent-zero/.agents/a0/inbox.log",
    f"{WS}/SISO_Agency/apps/siso-internal-labs/siso-internal-labs-agents/.agents/agent-base-inbox.log"])).split(":")
PLANS = os.environ.get("SPEND_PLANS")  # a glob; default: owners' .agents/plan/*.json under the workspace
A0_TASKS = os.environ.get("SPEND_A0_TASKS") or f"{WS}/SISO_Agents/agent-zero/siso-agent-zero/.agents/a0/tasks.json"
STATE = os.environ.get("SPEND_STATE") or os.path.expanduser("~/.local/state/spend-report")
TZ = dt.datetime.now().astimezone().tzinfo
PATH_PROJECTS = [("/agent-zero", "Agent Zero"), ("/partners/halo", "HALO"), ("/siso-internal-labs", "SISO Internal Labs"), ("/SISO_Agents", "SISO Internal Labs"),
                 ("/partners/fahmy", "Fahmy's agency"), ("/clients/fahmy", "Fahmy's agency"), ("/personal", "Personal")]


def load(name, file):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(HERE, file))
    m = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(m)
    return m


def ts(s):
    return dt.datetime.fromisoformat(str(s).replace("Z", "+00:00")).astimezone(TZ)


# ---- plan items -------------------------------------------------------------------------------------------------
def plan_items():
    items = {}
    files = glob.glob(PLANS) if PLANS else [f for depth in range(1, 6)
                                            for f in glob.glob(WS + "/*" * depth + "/.agents/plan/*.json")]
    for f in files:
        try:
            d = json.load(open(f))
        except (OSError, ValueError):
            continue
        for it in d.get("items") or []:
            if it.get("id"):
                items[it["id"]] = {"title": it.get("title", ""), "owner": d.get("owner"), "project": d.get("project"),
                                   "plan": os.path.basename(f)}
    try:
        tasks = json.load(open(A0_TASKS))
        for t in tasks.get("tasks", []) if isinstance(tasks, dict) else tasks:
            if isinstance(t, dict) and t.get("id"):
                items[t["id"]] = {"title": t.get("title", ""), "owner": t.get("owner"), "project": t.get("project"), "plan": "a0/tasks.json"}
    except (OSError, ValueError):
        pass
    return items


# ---- report lines ----------------------------------------------------------------------------------------------
def reports(day, ids):
    """[(time, agent, ids named, finished?)] for <day> from every inbox. A0's inbox has HH:MM only: days are counted
    back from the file's modified date across midnight wraps (as scripts/plan-report.py does)."""
    pat = re.compile(r"(?<![\w-])(" + "|".join(sorted(map(re.escape, ids), key=len, reverse=True)) + r")(?![\w-])") if ids else None
    out = []
    for path in INBOXES:
        try:
            lines = open(path, errors="replace").read().splitlines()
            cur = dt.datetime.fromtimestamp(os.path.getmtime(path), TZ).date()
        except OSError:
            continue
        later = None
        for l in reversed(lines):
            m = re.match(r"(?:(\d{4}-\d\d-\d\d) )?(\d\d):(\d\d)(?: [+-]\d{4})? ([A-Za-z0-9][A-Za-z0-9_-]*)[^:]*: (.*)", l)
            if not m:
                continue
            mins = int(m[2]) * 60 + int(m[3])
            if m[1]:
                date = dt.date.fromisoformat(m[1])
            else:
                if later is not None and mins - later > 360:
                    cur -= dt.timedelta(days=1)
                date = cur
            later = mins
            if date.isoformat() != day:
                continue
            t = dt.datetime(date.year, date.month, date.day, int(m[2]), int(m[3]), tzinfo=TZ)
            text = m[5]
            out.append((t, m[4], sorted(set(pat.findall(text))) if pat else [],
                        bool(re.search(r"\bDONE\b", text) or re.match(r"done\b", text))))
    return sorted(out)


# ---- spend events -----------------------------------------------------------------------------------------------
def claude_events(day):
    pr = load("plan_report", "scripts/plan-report.py")
    lo = dt.datetime.fromisoformat(day).replace(tzinfo=TZ).timestamp()
    ev, read, seen_all = [], set(), set()  # each transcript once (old folder names link to it), each message once
    for root in pr.ROOTS:
        root = os.path.expanduser(root)
        for f in glob.glob(root + "/*/*.jsonl") + glob.glob(root + "/*/*/subagents/*.jsonl"):
            if os.path.getmtime(f) < lo or os.path.realpath(f) in read:
                continue
            read.add(os.path.realpath(f))
            sub = "/subagents/" in f
            key = os.path.dirname(os.path.dirname(f)) + ".jsonl" if sub else f
            seen = seen_all if not sub else set()
            for line in open(f, errors="replace"):
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                nm = d.get("agentName") or d.get("customTitle")
                if nm:
                    NAMES.setdefault(key, nm)
                if d.get("cwd"):
                    CWDS.setdefault(key, d["cwd"])
                if d.get("type") != "assistant" or not d.get("timestamp") or pr.day_of(d["timestamp"]) != day:
                    continue
                m = d.get("message") or {}
                if m.get("id") in seen:
                    continue
                seen.add(m.get("id"))
                u = m.get("usage") or {}
                p = pr.PRICE[pr.family(m.get("model"))]
                w = (u.get("input_tokens", 0) * p[0] + u.get("cache_creation_input_tokens", 0) * p[1]
                     + u.get("cache_read_input_tokens", 0) * p[2] + u.get("output_tokens", 0) * p[3]) / 1e6
                ev.append({"t": ts(d["timestamp"]), "key": key, "claude": w, "codex": [0.0, 0.0]})
    herdr = herdr_names()
    for e in ev:
        sid = os.path.basename(e["key"])[:-6]
        e["agent"] = NAMES.get(e["key"]) or herdr.get(sid) or short(CWDS.get(e["key"]))
        e["cwd"] = CWDS.get(e["key"], "")
    return ev


def herdr_names():
    """Remember which herdr agent runs which Claude session or Codex thread: its name, else its tab label (live
    list now, merged with what earlier runs saw, so a closed agent keeps its name)."""
    path = os.path.join(STATE, "session-names.json")
    try:
        names = json.load(open(path))
    except (OSError, ValueError):
        names = {}
    try:
        run = lambda *a: json.loads(subprocess.run(["herdr", *a], capture_output=True, text=True, timeout=10).stdout)["result"]
        labels = {t["tab_id"]: t.get("label") for t in run("tab", "list")["tabs"]}
        for a in run("agent", "list")["agents"]:
            sid = (a.get("agent_session") or {}).get("value")
            nm = a.get("name") or labels.get(a.get("tab_id"))
            if sid and nm:
                names[sid] = nm
        os.makedirs(STATE, exist_ok=True)
        json.dump(names, open(path + ".tmp", "w"))
        os.replace(path + ".tmp", path)
    except Exception:
        pass
    return names


def codex_events(day):
    cc = load("codex_credits", "bin/codex-credits")
    names = herdr_names()
    runs = {}
    try:  # codex-run's log: the caller's dir for each run
        for l in open(os.path.expanduser("~/.local/state/codex-run/log.jsonl")):
            r = json.loads(l)
            runs[r.get("run", "")] = r.get("dir")
    except (OSError, ValueError):
        pass
    lo = dt.datetime.fromisoformat(day).replace(tzinfo=TZ).timestamp()
    ev = []
    for f in glob.glob(os.path.join(cc.SESSIONS, "**", "rollout-*.jsonl"), recursive=True):
        if os.path.getmtime(f) < lo:
            continue
        model, sid, cwd = None, None, ""
        for line in open(f, errors="replace"):
            if not any(k in line for k in ('"session_meta"', '"turn_context"', '"token_usage_record"')):
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            p = e.get("payload") or {}
            if e.get("type") == "session_meta":
                sid, cwd = p.get("id") or p.get("session_id"), p.get("cwd", "")
            elif e.get("type") == "turn_context":
                model = p.get("model") or model
                cwd = p.get("cwd") or cwd
            elif e.get("type") == "token_usage_record" and p.get("usage") and cc.local_day(e["timestamp"]) == day:
                u = p["usage"]
                c = cc.price(model, {"input": u.get("input_tokens", 0), "cached": u.get("cached_input_tokens", 0),
                                     "output": u.get("output_tokens", 0)}) or [0.0, 0.0]
                agent = names.get(sid) or "codex " + short(cwd)
                ev.append({"t": ts(e["timestamp"]), "agent": agent, "cwd": cwd, "claude": 0.0, "codex": c, "model": model})
    return ev


NAMES, CWDS = {}, {}


def short(cwd):
    """An unnamed session's label: its folder, with throwaway temp dirs folded into one bucket."""
    if not cwd:
        return "cwd:?"
    if "/T/" in cwd or cwd.startswith(("/tmp", "/private/tmp", "/private/var")):
        return "cwd:temp"
    return "cwd:" + os.path.basename(cwd.rstrip("/"))


def who(agent, cwd, reg):
    a = reg.get(agent) or reg.get(agent.upper()) or {}
    project = a.get("project")
    if not project:
        project = next((p for k, p in PATH_PROJECTS if k in (cwd or "")), "Unassigned")
    owner = a.get("owner") or (agent if a.get("kind") == "owner" else None) or agent
    return project, owner


def report(day):
    try:
        reg = json.load(open(REGISTRY)).get("agents", {})
    except (OSError, ValueError):
        reg = {}
    items = plan_items()
    reps = reports(day, items.keys())
    by_agent_reports = collections.defaultdict(list)
    for t, a, ids, fin in reps:
        by_agent_reports[a.upper()].append((t, ids, fin))
    ev = claude_events(day) + codex_events(day)
    tree = {}
    plan = collections.defaultdict(lambda: {"claude": 0.0, "codex": [0.0, 0.0], "steps": 0, "finished": False})
    for e in ev:
        project, owner = who(e["agent"], e["cwd"], reg)
        node = tree.setdefault(project, {}).setdefault(owner, {}).setdefault(e["agent"], {
            "claude": 0.0, "codex": [0.0, 0.0], "steps": 0, "items": collections.Counter(), "finished": 0})
        node["claude"] += e["claude"]
        node["codex"] = [node["codex"][0] + e["codex"][0], node["codex"][1] + e["codex"][1]]
        node["steps"] += 1
        nxt = next((ids for t, ids, _ in by_agent_reports.get(e["agent"].upper(), []) if t >= e["t"].replace(second=0, microsecond=0) and ids), None)
        for i in (nxt or ["unattributed"]):
            share = 1 / len(nxt) if nxt else 1
            k = i if nxt else f"unattributed:{project}"
            plan[k]["claude"] += e["claude"] * share
            plan[k]["codex"] = [plan[k]["codex"][0] + e["codex"][0] * share, plan[k]["codex"][1] + e["codex"][1] * share]
            plan[k]["steps"] += share
            node["items"][i] += share
    finished_ids = {i for _, _, ids, fin in reps if fin for i in ids}
    for i in finished_ids:
        plan[i]["finished"] = True
    for a, rs in by_agent_reports.items():
        n = sum(1 for _, _, fin in rs if fin)
        for project in tree.values():
            for owner in project.values():
                for name, node in owner.items():
                    if name.upper() == a:
                        node["finished"] = n
    r2 = lambda x: round(x, 1)
    projects = []
    for project, owners in sorted(tree.items()):
        po = []
        for owner, agents in sorted(owners.items()):
            ag = [{"agent": n, "claude_usd_equiv": r2(v["claude"]), "codex_credits": [r2(v["codex"][0]), r2(v["codex"][1])],
                   "steps": v["steps"], "finished": v["finished"],
                   "items": {k: round(s) for k, s in v["items"].most_common()}} for n, v in sorted(agents.items(), key=lambda kv: -kv[1]["claude"])]
            po.append({"owner": owner, "claude_usd_equiv": r2(sum(x["claude_usd_equiv"] for x in ag)),
                       "codex_credits": [r2(sum(x["codex_credits"][0] for x in ag)), r2(sum(x["codex_credits"][1] for x in ag))],
                       "finished": sum(x["finished"] for x in ag), "agents": ag})
        projects.append({"project": project, "claude_usd_equiv": r2(sum(o["claude_usd_equiv"] for o in po)),
                         "codex_credits": [r2(sum(o["codex_credits"][0] for o in po)), r2(sum(o["codex_credits"][1] for o in po))],
                         "finished": sum(o["finished"] for o in po), "owners": sorted(po, key=lambda o: -o["claude_usd_equiv"])})
    projects.sort(key=lambda p: -p["claude_usd_equiv"])
    plan_rows = sorted(({"id": k, "title": items.get(k, {}).get("title", ""), "plan": items.get(k, {}).get("plan"),
                         "claude_usd_equiv": r2(v["claude"]), "codex_credits": [r2(v["codex"][0]), r2(v["codex"][1])],
                         "steps": round(v["steps"]), "finished": v["finished"]} for k, v in plan.items()),
                       key=lambda r: -r["claude_usd_equiv"])
    total = sum(p["claude_usd_equiv"] for p in projects)
    un = sum(r["claude_usd_equiv"] for r in plan_rows if r["id"].startswith("unattributed"))
    return {"day": day, "claude_usd_equiv": r2(total),
            "codex_credits": [r2(sum(p["codex_credits"][0] for p in projects)), r2(sum(p["codex_credits"][1] for p in projects))],
            "attributed_to_plan_items": round(1 - un / total, 3) if total else 0,
            "finished": sum(1 for *_, fin in reps if fin), "projects": projects, "plan_items": plan_rows,
            "note": "claude_usd_equiv = tokens x API list price per model: a relative weight for comparing spend, not a bill"}


def main(argv):
    day = argv[argv.index("--day") + 1] if "--day" in argv else dt.datetime.now(TZ).date().isoformat()
    r = report(day)
    if "--json" in argv:
        print(json.dumps(r, indent=1))
        return 0
    cr = lambda c: f"{c[0]:,.0f}" if c[0] == c[1] else f"{c[0]:,.0f}-{c[1]:,.0f}"
    print(f"Spend {r['day']}: Claude ${r['claude_usd_equiv']:,.0f} API-equivalent, Codex {cr(r['codex_credits'])} credits; "
          f"{r['finished']} finished; {r['attributed_to_plan_items']:.0%} of Claude spend tied to plan items")
    for p in r["projects"]:
        print(f"  spent ${p['claude_usd_equiv']:,.0f} + {cr(p['codex_credits'])} cr on {p['project']} -> finished {p['finished']}")
        for o in p["owners"][:6]:
            agents = ", ".join(f"{a['agent']} ${a['claude_usd_equiv']:,.0f}" for a in o["agents"][:4])
            print(f"      {o['owner']}: ${o['claude_usd_equiv']:,.0f}, finished {o['finished']} ({agents})")
    print("  top plan items:")
    for it in r["plan_items"][:8]:
        print(f"      {it['id']:<28} ${it['claude_usd_equiv']:,.0f} + {cr(it['codex_credits'])} cr"
              f"{' ✅' if it['finished'] else ''}  {it['title'][:60]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
