#!/usr/bin/env bash
set -euo pipefail

# Lordsisodia's Claude subscription has its own account state and Keychain login.
# The profile shares the existing SISO settings, hooks, skills, and plugins.
export CLAUDE_CONFIG_DIR="$HOME/.config/claude-siso-3"
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
unset CLAUDE_CODE_OAUTH_REFRESH_TOKEN CLAUDE_CODE_OAUTH_SCOPES

# No forced early compaction. The morning of 1 Oct this set 45% for every agent; that evening one was
# auto-compacted mid-conversation with Shaan (transcript 1825d2cd: trigger auto at 483k tokens), and he
# reversed it: "agents should just be pinged like not too heavily but like nicely ... we kind of want to
# leave the reasoning up to the agents". Claude Code's default (about 95%) stays as the last-resort net;
# agents are pinged about context and compact themselves at a clean break (the self-compact skill).
unset CLAUDE_AUTOCOMPACT_PCT_OVERRIDE

# Context cap per agent (Shaan, 2 Oct ~14:25: a scale, ~200k workers to ~600k heavy reasoning): -n NAME or --cap TIER|N
# picks it from config/context-caps.json and exports CONTEXT_PING_AT for the context-ping hook.
source "$(dirname "$(readlink -f "$0")")/context-cap.sh"
siso_context_cap "$@"
# One config home (native-agents step 4): opt-in only (SISO_ONE_HOME=1) until lordsisodia has a token (parked 2 Oct).
source "$(dirname "$(readlink -f "$0")")/one-home.sh"
siso_one_home lordsisodia off
# Lean boot for agents (Artifact off, unused skills name-only, no claude.ai connectors or Chrome); SISO_FULL_BOOT=1 skips.
source "$(dirname "$(readlink -f "$0")")/agent-boot.sh"
siso_agent_boot
exec "$HOME/.local/bin/claude" ${SISO_ARGS[@]+"${SISO_ARGS[@]}"}
