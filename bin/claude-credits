#!/usr/bin/env python3
"""claude-credits [--json] [--no-sample] — the Claude dollar grants on each SISO login: limit, used, left, end date.

Shaan, 2 Oct (via A0, ab-107/so-022): "two accounts with Claude's cloud credits that should be used $250 worth" ...
"Cloud credits would be great ... it's like free". Each login's usage endpoint (the one Claude Code's /usage reads) lists
buckets; a grant is a bucket with limit_dollars. Found 2 Oct: fuzeheritage (claude-siso) has $250, $0 used, ending
2026-11-05 07:59 UTC; lordsisodia (claude-siso-3) has none. Plain `claude` (Fahmy's login) is never read or used.

The OAuth token is read from the login's Keychain item in memory and never printed or logged. Every run appends a
sample to $CLAUDE_CREDITS_STATE/samples.jsonl (default ~/.local/state/claude-credits) when a number moved, so
bin/burn-rate can show dollars per hour and bin/spend-ledger can charge the day's spend to cloud tasks.
Exit 0 ok, 1 no login could be read.
"""
import datetime as dt, hashlib, json, os, subprocess, sys, urllib.request

LOGINS = [("claude-siso", "~/.claude-siso"), ("claude-siso-3", "~/.config/claude-siso-3")]  # never plain claude (~/.claude)
STATE = os.environ.get("CLAUDE_CREDITS_STATE") or os.path.expanduser("~/.local/state/claude-credits")
API = os.environ.get("CLAUDE_CREDITS_API") or "https://api.anthropic.com"


def token(cfg):
    """The login's OAuth access token from its Keychain item (service 'Claude Code-credentials-<sha256(dir)[:8]>')."""
    svc = "Claude Code-credentials-" + hashlib.sha256(os.path.expanduser(cfg).encode()).hexdigest()[:8]
    raw = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"], capture_output=True, text=True).stdout.strip()
    try:
        return json.loads(raw)["claudeAiOauth"]["accessToken"]
    except (ValueError, KeyError, TypeError):
        return None


def get(path, tok):
    req = urllib.request.Request(API + path, headers={"Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20"})
    return json.loads(urllib.request.urlopen(req, timeout=15).read())


def grants(usage):
    return [{"bucket": k, "limit_usd": v["limit_dollars"], "used_usd": v.get("used_dollars") or 0.0,
             "left_usd": v.get("remaining_dollars"), "ends": v.get("resets_at"), "locked": v.get("locked_reason")}
            for k, v in sorted(usage.items()) if isinstance(v, dict) and v.get("limit_dollars")]


def read_all(fetch=None):
    fetch = fetch or (lambda login, cfg: (lambda t: t and (get("/api/oauth/profile", t), get("/api/oauth/usage", t)))(token(cfg)))
    out = []
    for login, cfg in LOGINS:
        try:
            got = fetch(login, cfg)
        except Exception as e:  # an expired token or the network: report, never fail the others
            out.append({"login": login, "error": f"{type(e).__name__} {getattr(e, 'code', '')}".strip()})
            continue
        if not got:
            out.append({"login": login, "error": "no token"})
            continue
        prof, use = got
        out.append({"login": login, "email": prof["account"]["email"], "grants": grants(use)})
    return out


def sample(rows, now=None):
    """Append one row per grant whose used figure moved since the last sample (or every 10 min while steady)."""
    os.makedirs(STATE, exist_ok=True)
    now = now or dt.datetime.now(dt.timezone.utc)
    last_f = os.path.join(STATE, "last.json")
    try:
        last = json.load(open(last_f))
    except (OSError, ValueError):
        last = {}
    wrote = []
    for r in rows:
        for g in r.get("grants", []):
            k = f"{r['login']}/{g['bucket']}"
            prev = last.get(k)
            if prev and prev["used_usd"] == g["used_usd"] and (now - dt.datetime.fromisoformat(prev["at"])).total_seconds() < 600:
                continue
            row = {"at": now.isoformat(timespec="seconds"), "login": r["login"], "bucket": g["bucket"], "used_usd": g["used_usd"],
                   "limit_usd": g["limit_usd"], "ends": g["ends"]}
            last[k] = row
            wrote.append(row)
            with open(os.path.join(STATE, "samples.jsonl"), "a") as f:
                f.write(json.dumps(row) + "\n")
    json.dump(last, open(last_f + ".tmp", "w"))
    os.replace(last_f + ".tmp", last_f)
    return wrote


def main(argv):
    rows = read_all()
    if "--no-sample" not in argv:
        sample(rows)
    if "--json" in argv:
        print(json.dumps(rows, indent=1))
    else:
        for r in rows:
            if r.get("error"):
                print(f"{r['login']}: unreadable ({r['error']})")
                continue
            if not r["grants"]:
                print(f"{r['login']} ({r['email']}): no dollar grant")
            for g in r["grants"]:
                print(f"{r['login']} ({r['email']}): ${g['used_usd']:,.2f} of ${g['limit_usd']:,.0f} used, ${g['left_usd']:,.2f} left, "
                      f"ends {g['ends'][:16].replace('T', ' ')} UTC")
    return 0 if any(not r.get("error") for r in rows) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
