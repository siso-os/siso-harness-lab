{
  "sisodias/siso-code": {
    "setup": "pnpm install --frozen-lockfile --prefer-offline",
    "test": "pnpm exec vp test run",
    "mode": "all",
    "why": "PR gate runs only the tests the diff touches (vitest --changed against the merge-base); docs-only diffs pass at once; the lockfile or root config runs the full suite. Shaan, 17 Oct: \"we don't even need to do these checks\". Main is never run with --changed.",
    "sharding": {
      "count": 2,
      "min_files": 100,
      "test_glob": "**/*.test.ts"
    },
    "affected": {
      "changed": "pnpm exec vp test run --changed \"$SISO_CI_BASE\" --passWithNoTests",
      "ignore": [
        "*.md",
        "docs/*",
        "docs/**",
        "reports/*",
        "research/*",
        "*.txt",
        "LICENSE",
        ".agents/*",
        "_archive/*"
      ],
      "shared": [
        "pnpm-lock.yaml",
        "package.json",
        "pnpm-workspace.yaml",
        "vite.config.*",
        "vitest.config.*",
        "tsconfig.base.json"
      ]
    }
  },
